<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="com.example.carsettings.CATEGORY_PROVIDER" />
        </intent>
    </queries>

    <application
        android:name=".LifecycleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifecycleApp"
        tools:targetApi="31">

        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />
        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_ALLOW_SYSTEM"
            android:value="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.example.lifecycleapp.SplitInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name=".PrimaryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="@string/title_primary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.lifecycleapp.open" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Navigation 2.x Deep Link Intent Filter for myapp://navigate -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="myapp"
                    android:host="navigate" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Secondary1Activity"
            android:exported="false"
            android:label="@string/title_secondary1" />

        <activity
            android:name=".Secondary2Activity"
            android:exported="false"
            android:label="@string/title_secondary2" />

        <activity
            android:name=".GenericSettingsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="Settings">
            <intent-filter>
                <action android:name="com.example.carsettings.door.OPEN" />
                <action android:name="com.example.carsettings.seat.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".HardwareSimulationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.carsettings.SIMULATE_HARDWARE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
