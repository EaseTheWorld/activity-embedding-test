<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.ACTIVITY_EMBEDDING"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.MANAGE_ACTIVITY_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <intent>
            <action android:name="com.example.carsettings.CATEGORY_PROVIDER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".LifecycleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifecycleApp"
        tools:targetApi="31">

        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />
        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_ALLOW_SYSTEM"
            android:value="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.example.lifecycleapp.SplitInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".DeepLinkRouterActivity"
            android:exported="true"
            android:taskAffinity="com.example.lifecycleapp.deeplink"
            android:theme="@style/Theme.LifecycleApp.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.example.lifecycleapp.open" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="myapp"
                    android:host="navigate" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ListActivity"
            android:exported="true"
            android:theme="@style/Theme.LifecycleApp"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="@string/title_primary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ListOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.LifecycleApp.Translucent"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="@string/title_primary" />

        <activity
            android:name=".ListWithTranslucentActivity"
            android:exported="false"
            android:theme="@style/Theme.LifecycleApp.Translucent"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="@string/title_primary" />

        <activity
            android:name=".Secondary1Activity"
            android:exported="false"
            android:label="@string/title_secondary1" />

        <activity
            android:name=".Secondary2Activity"
            android:exported="true"
            android:label="@string/title_secondary2" />

        <activity
            android:name=".GenericSettingsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="Settings">
            <intent-filter>
                <action android:name="com.example.carsettings.door.OPEN" />
                <action android:name="com.example.carsettings.seat.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <service
            android:name=".FloatingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps privileged task-visibility observer unfrozen while Narrow Mode floating edge handle is attached across internal and external plugin activities." />
        </service>

        <receiver
            android:name=".HardwareSimulationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.carsettings.SIMULATE_HARDWARE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
